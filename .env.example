# =============================================================================
# Environment Configuration
# =============================================================================
# Copy this file to .env.local and fill in the values for local development.
# See docs/production-checklist.md §2 for details.
# =============================================================================

# -----------------------------------------------------------------------------
# Required Variables
# -----------------------------------------------------------------------------

# Node environment: development | production | test
NODE_ENV=development

# Base URL for the Hacker News API
# Official HN API: https://hacker-news.firebaseio.com
HN_API_BASE_URL=https://hacker-news.firebaseio.com

# -----------------------------------------------------------------------------
# Optional Variables (with defaults)
# -----------------------------------------------------------------------------

# Data source adapter to use
# Options: hackernews (default)
# DATA_SOURCE=hackernews

# Logging level: error | warn | info | debug
# Default: info
# LOG_LEVEL=info

# Cache TTL in seconds for Next.js fetch revalidation
# Default: 60
# CACHE_TTL_SECONDS=60

# API request timeout in milliseconds
# Default: 10000 (10 seconds)
# API_TIMEOUT_MS=10000

# Number of retry attempts for failed API requests
# Default: 3
# API_RETRY_COUNT=3

# -----------------------------------------------------------------------------
# Typesense Configuration (for search functionality)
# -----------------------------------------------------------------------------

# Typesense host
# Default: localhost
# TYPESENSE_HOST=localhost

# Typesense port
# Default: 8108
# TYPESENSE_PORT=8108

# Typesense protocol (http or https)
# Default: http
# TYPESENSE_PROTOCOL=http

# Typesense Admin API key (required for ingestion/indexing)
# This key has full permissions for collection management and document indexing
# TYPESENSE_ADMIN_API_KEY=your-admin-api-key

# Typesense Search API key (required for search functionality)
# This key should only have search permissions (safer to expose)
# TYPESENSE_SEARCH_API_KEY=your-search-api-key

# Typesense collection name
# Default: posts
# TYPESENSE_COLLECTION=posts

# -----------------------------------------------------------------------------
# Cron Configuration
# -----------------------------------------------------------------------------

# Secret for protecting the ingestion cron endpoint
# Required in production to prevent unauthorized access
# CRON_SECRET=your-cron-secret
